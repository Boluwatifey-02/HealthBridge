# Deployed HealthBridge backend, e.g. https://healthbridge-api.onrender.com/api
# The local backend default matches the port the test suites use.
VITE_API_URL=http://localhost:5050/api

# Public contact details shown in the contact section and the footer.
# Leave these blank rather than filling in numbers or addresses that have not
# been verified. When they are blank the interface points people at the contact
# form instead of showing contact details that nobody answers.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
