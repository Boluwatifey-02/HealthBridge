# Copy this file to .env and fill in real values. Never commit .env to Git.

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=healthbridge_user
DB_PASSWORD=change_this_password
DB_NAME=healthbridge_db

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# AI API (for report summarization — see utils/aiHelpers.js)
# This project deliberately keeps AI calls optional: if no key is set,
# the system falls back to the same rule-based summarizer used in the
# frontend demo, so the app still runs without one.
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages

# CORS
FRONTEND_ORIGIN=http://localhost:5173
