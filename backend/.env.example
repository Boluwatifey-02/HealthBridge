# HealthBridge backend configuration

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string
JWT_EXPIRES_IN=8h

# Production MySQL connection details
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=healthbridge

# Optional: set to true on first production boot to create the default staff accounts.
SEED_STAFF=false
SEED_ADMIN_PASSWORD=set_a_strong_admin_password
SEED_DOCTOR_PASSWORD=set_a_strong_doctor_password
SEED_RECEPTION_PASSWORD=set_a_strong_reception_password