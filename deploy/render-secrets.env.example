# HealthBridge Render deployment secrets
#
# Copy this file to render-secrets.env in the SAME folder and fill in the
# two SECRET values below. render-secrets.env is gitignored and is never
# committed to GitHub.
#
#   Copy-Item render-secrets.env.example render-secrets.env
#
# deploy-backend.js reads this file to authenticate against the Render API and
# to set the backend's environment variables. It never prints these values.
# GENERATED_* entries are written automatically on first run and reused after.

# ---------------------------------------------------------------- SECRET 1/2
# Render API key. Create at https://dashboard.render.com/settings/api
# Use the key named "HealthBridge Deployment".
RENDER_API_KEY=

# ---------------------------------------------------------------- SECRET 2/2
# Password for the Aiven MySQL user.
# Aiven Console -> your HealthBridge MySQL service -> Users -> avnadmin -> Password
# Keep the double quotes exactly as shown.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Non-secret Aiven connection details (already filled in).
# --------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OPTIONAL: SMTP, for real password-reset emails.
#
# Leave SMTP_HOST, SMTP_USER and SMTP_PASS blank and the backend writes each
# password-reset link to the Render server log instead of emailing it. The
# reset flow still works completely; only the delivery channel differs.
#
# To switch on real email, use a FREE SMTP account, for example a Gmail App
# Password (Google Account -> Security -> 2-Step Verification -> App passwords)
# or a Mailtrap account. Nodemailer is MIT licensed and free, so no paid mail
# provider is required.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HealthBridge <no-reply@healthbridge.org>

# ---------------------------------------------------------------------------
# Demo password reset, for deployments with no SMTP account.
#
# When SMTP is not configured the backend cannot send email, so the API says
# so honestly instead of claiming a message was sent. Set this to true to also
# return the reset link on screen, which lets the full
# forgot -> reset -> sign in journey be demonstrated with no paid mail service.
#
# Set it to false for a real production deployment that sends email, so the
# reset link is never exposed in the browser.
# ---------------------------------------------------------------------------
DEMO_PASSWORD_RESET_LINK=true
