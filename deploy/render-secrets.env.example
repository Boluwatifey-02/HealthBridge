# HealthBridge Render deployment secrets
#
# Copy this file to render-secrets.env in the SAME folder and fill in the
# two values below. render-secrets.env is gitignored and is never committed.
#
#   Copy-Item render-secrets.env.example render-secrets.env
#
# deploy-backend.js reads this file to authenticate against the Render API and
# to set the backend's environment variables. It never prints these values.

# Render API key.
# Create at https://dashboard.render.com/settings/api  ("HealthBridge Deployment")
RENDER_API_KEY=

# Password for the Aiven MySQL user "avnadmin".
# Aiven Console -> your HealthBridge service -> Users -> avnadmin -> Password
# Leave the quotes exactly as shown.
DB_PASSWORD=